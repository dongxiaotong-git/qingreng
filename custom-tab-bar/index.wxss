.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 48rpx;
  filter: grayscale(100%);
  opacity: 0.6;
}
.tab-icon.active {
  filter: none;
  opacity: 1;
  transform: translateY(-2rpx);
}

.tab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}
