.banner {
  border: 2rpx solid;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.banner-status {
  font-size: 36rpx;
  font-weight: 700;
}
.banner-no {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.kv {
  display: flex;
  padding: 14rpx 0;
  font-size: 28rpx;
}
.k {
  width: 150rpx;
  color: #999;
  flex-shrink: 0;
}
.v {
  flex: 1;
  color: #333;
}

.sub-title {
  font-size: 26rpx;
  color: #666;
  margin: 16rpx 0 12rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  text-align: center;
  line-height: 160rpx;
  font-size: 26rpx;
  color: #07c160;
  background: #fafafa;
}
.proof {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.action-card {
  border: 2rpx solid #07c160;
}
.tip {
  font-size: 24rpx;
  color: #b8860b;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx;
  line-height: 1.5;
}
.action-btn {
  width: 100%;
  margin-top: 24rpx;
  line-height: 88rpx;
}
