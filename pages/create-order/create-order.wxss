.pkg-info .pkg-name {
  font-size: 32rpx;
  font-weight: 700;
}
.pkg-info .pkg-price {
  color: #fa541c;
  font-size: 34rpx;
  font-weight: 700;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.form-value {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}
.req {
  color: #fa541c;
}

.form-block {
  margin-top: 28rpx;
}

.form-textarea {
  margin-top: 14rpx;
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 90rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 14rpx;
}
.option {
  padding: 16rpx 28rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: #fff;
  color: #333;
}
.option-active {
  border-color: #07c160;
  background: #eafaf0;
  color: #07c160;
  font-weight: 600;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b8860b;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 16rpx;
  line-height: 1.5;
}

.picker {
  margin-top: 14rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 14rpx;
}
.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  text-align: center;
  line-height: 160rpx;
  font-size: 60rpx;
  color: #bbb;
  background: #fafafa;
}

.submit-btn {
  width: 100%;
  margin-top: 30rpx;
  line-height: 88rpx;
}
