<view class="login">
  <view class="hero">
    <view class="logo">♻️</view>
    <view class="title">代扔垃圾</view>
    <view class="slogan">足不出户，垃圾有人帮扔</view>
  </view>

  <view class="card form">
    <!-- 头像：微信头像填写能力 -->
    <view class="field avatar-field">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">＋</view>
      </button>
    </view>

    <!-- 昵称：微信昵称填写能力 -->
    <view class="field">
      <text class="label">昵称</text>
      <input
        class="input"
        type="nickname"
        placeholder="点击从微信获取昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <!-- 手机号：手动输入兜底 + 微信授权（企业主体） -->
    <view class="field">
      <text class="label">手机号（选填，用于识别角色）</text>
      <view class="phone-row">
        <input
          class="input phone-input"
          type="number"
          maxlength="11"
          placeholder="手动输入"
          value="{{phone}}"
          bindinput="onInputPhone"
        />
        <button
          class="btn-ghost phone-btn {{phoneAuthorized ? 'phone-btn-ok' : ''}}"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >{{phoneAuthorized ? '已授权' : '微信授权'}}</button>
      </view>
      <view wx:if="{{phoneAuthorized}}" class="tip">已获得授权，点击登录时自动解密真实手机号</view>
    </view>

    <view class="hint">{{demoHint}}</view>

    <button class="btn-primary login-btn" bindtap="onLogin">登录</button>
  </view>
</view>
