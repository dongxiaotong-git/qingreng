<view class="login">
  <view class="hero">
    <view class="logo">♻️</view>
    <view class="title">代扔垃圾</view>
    <view class="slogan">足不出户，垃圾有人帮扔</view>
  </view>

  <view class="card form">
    <!-- 头像：微信头像填写能力 -->
    <view class="field avatar-field">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError" />
        <view wx:else class="avatar-default">＋</view>
      </button>
    </view>

    <!-- 昵称：微信昵称填写能力 -->
    <view class="field">
      <text class="label">昵称</text>
      <input
        class="input"
        type="nickname"
        placeholder="点击从微信获取昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <!-- 登录：wx.login 换取 openid 作为唯一标识，权限由服务端按 openid 判定 -->
    <button
      class="btn-primary login-btn"
      bindtap="onLogin"
      loading="{{loading}}"
    >微信一键登录</button>
  </view>
</view>
