<view class="login">
  <view class="hero">
    <view class="logo">♻️</view>
    <view class="title">代扔垃圾</view>
    <view class="slogan">足不出户，垃圾有人帮扔</view>
  </view>

  <view class="card form">
    <!-- 头像：微信头像填写能力 -->
    <view class="field avatar-field">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-default">＋</view>
      </button>
    </view>

    <!-- 昵称：微信昵称填写能力 -->
    <view class="field">
      <text class="label">昵称</text>
      <input
        class="input"
        type="nickname"
        placeholder="点击从微信获取昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <!-- 手机号：仅通过微信授权自动获取，不支持手动输入 -->
    <view class="field">
      <text class="label">手机号</text>
      <view class="phone-box {{phone ? 'phone-box-ok' : ''}}">
        <text wx:if="{{phone}}" class="phone-text">{{phone}}</text>
        <text wx:else class="phone-placeholder">点击下方按钮，自动获取微信绑定手机号</text>
      </view>
      <view wx:if="{{phone}}" class="tip">✓ 已通过微信授权获取</view>
    </view>

    <!-- 登录按钮即手机号授权按钮：点一次 = 授权手机号 + wx.login 登录 -->
    <button
      class="btn-primary login-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onLogin"
      loading="{{loading}}"
    >微信一键登录</button>
  </view>
</view>
