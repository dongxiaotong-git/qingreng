.login {
  min-height: 100vh;
  background: linear-gradient(180deg, #07c160 0%, #07c160 38%, #f5f6f8 38%, #f5f6f8 100%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 90rpx 0 60rpx;
  text-align: center;
  color: #fff;
}
.logo {
  font-size: 96rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 10rpx;
}
.slogan {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.form {
  border-radius: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}
.input {
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}

/* 头像选择按钮 */
.avatar-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.avatar-default {
  font-size: 56rpx;
  color: #bbb;
}


/* 登录页不再提供身份选择，角色由后台按手机号配置 */

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}
