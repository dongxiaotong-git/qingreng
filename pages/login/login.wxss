.login {
  min-height: 100vh;
  background: linear-gradient(180deg, #07c160 0%, #07c160 38%, #f5f6f8 38%, #f5f6f8 100%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 90rpx 0 60rpx;
  text-align: center;
  color: #fff;
}
.logo {
  font-size: 96rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 10rpx;
}
.slogan {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.form {
  border-radius: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}
.input {
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}

/* 头像选择按钮 */
.avatar-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.avatar-default {
  font-size: 56rpx;
  color: #bbb;
}

/* 手机号：只读展示，由微信授权自动填充 */
.phone-box {
  background: #f7f8fa;
  border: 2rpx dashed #dcdfe6;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  min-height: 40rpx;
}
.phone-box-ok {
  border-style: solid;
  border-color: #b7e8c8;
  background: #f2fbf5;
}
.phone-text {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.phone-placeholder {
  font-size: 26rpx;
  color: #b0b4bb;
}
.tip {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 10rpx;
}

.roles {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.role {
  flex: 1;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  background: #fff;
}
.role-active {
  border-color: #07c160;
  background: #eafaf0;
}
.role-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.role-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}

.hint {
  font-size: 22rpx;
  color: #999;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}
